# atlas-native-s3: S3 gateway for atlas-native filesystems (docs/NATIVE_S3.md). Talks to the cluster
# over its HTTP API, so unlike the NFS gateway it needs no FUSE and no privileges.
# ---- builder ----
FROM docker.io/library/rust:1.99-bookworm@sha256:59037199c44290f2befcdd58dcc540164763fc296950255aaefeef096a1866b0 AS builder
WORKDIR /build
COPY . .
RUN cargo build --release --locked -p atlas-native-s3 --bin atlas-native-s3

# ---- runtime ----
FROM docker.io/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 atlas-native-s3
COPY --from=builder /build/target/release/atlas-native-s3 /usr/local/bin/atlas-native-s3
USER atlas-native-s3
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/atlas-native-s3"]
