# Atlas gateway configuration (all values optional; sane dev defaults apply).

# HTTP (REST) bind address for atlas-gateway.
ATLAS_BIND_ADDR=127.0.0.1:5110

# gRPC bind address (empty disables the gRPC edge).
ATLAS_GRPC_ADDR=127.0.0.1:5111

# SQLite database URL. create_if_missing + WAL are applied automatically.
ATLAS_DATABASE_URL=sqlite://atlas.db?mode=rwc

# Ceph driver mode: "real" shells out to ceph/rbd; "fake" serves canned fixtures
# for local dev / tests where no Ceph cluster is available.
ATLAS_CEPH_DRIVER_MODE=fake

# Path to a kubeconfig for the live k8s driver. Empty = in-cluster / default resolution.
# KUBECONFIG is also honored by kube-rs.
ATLAS_KUBECONFIG=

# JWT secret used to verify product/service and user tokens. MUST be set (>=32 bytes)
# in production; the gateway refuses to start when ATLAS_AUTH_REQUIRED=1 and this is
# the weak default below (or shorter than 32 bytes). Local `make run` leaves auth off.
ATLAS_JWT_SECRET=atlas-dev-jwt-secret-change-me-please-32b

# Set to "1" to require a valid JWT on protected routes. "0" (dev) leaves them open.
# Cluster manifests set this to "1" and load the secret from `atlas-gateway-auth`.
ATLAS_AUTH_REQUIRED=0

# Optional one-shot admin bearer (raw string, not a JWT) accepted when auth is required.
# Use once to POST /auth/tokens, then unset. Deploy scripts store this in the Secret.
# ATLAS_BOOTSTRAP_ADMIN_TOKEN=
# Default number of backups to retain per volume (0 = unlimited); overridable per request ("keep").
ATLAS_BACKUP_KEEP=0

# Prune backups older than this many seconds (0 = disabled); overridable per request ("max_age_secs").
ATLAS_BACKUP_MAX_AGE_SECS=0

# Monitor/alerts worker interval in seconds (0 disables it). Each tick refreshes inventory via
# discovery and evaluates alert rules (cluster unhealthy, pool near-full, OSD down).
ATLAS_MONITOR_INTERVAL_SECS=60

# Ceph mgr Prometheus /metrics URL to scrape each monitor tick (empty disables metric collection).
# In a Rook cluster: http://rook-ceph-mgr.rook-ceph.svc:9283/metrics
ATLAS_CEPH_PROMETHEUS_URL=

# Optional second NFS backend (demonstrates the pluggable-driver architecture). When enabled it
# registers alongside Ceph and appears in /backends, /clusters, /pools, /volumes with fixture
# capacity (a real driver would run `showmount -e` + `df`).
ATLAS_NFS_ENABLE=0
ATLAS_NFS_SERVER=nfs01.zyvor.lab
ATLAS_NFS_EXPORTS=/exports/vmstore,/exports/backups

# Optional live Longhorn discovery (requires reachable Kubernetes and Longhorn v1beta2 CRDs).
# The gateway service account needs get/list/watch on longhorn.io nodes and volumes.
ATLAS_LONGHORN_ENABLE=0
ATLAS_LONGHORN_NAMESPACE=longhorn-system

# Optional webhook notified when an alert fires (Slack-compatible JSON: {text, alert{…}}).
# Fired once per firing; re-fires when a resolved alert re-opens. Empty disables notifications.
# e.g. a Slack incoming-webhook URL, or any HTTP endpoint that 2xx-acks.
ATLAS_ALERT_WEBHOOK_URL=

# Public RGW endpoint used to sign presigned backup-download URLs so they resolve off-cluster
# (empty = use the bucket's in-cluster endpoint). e.g. http://<node-ip>:30513
ATLAS_RGW_PUBLIC_ENDPOINT=

# How often (seconds) the protection-schedule worker checks for due snapshot schedules (0 disables).
ATLAS_SNAPSHOT_TICK_SECS=60

# Durable job queue poller (seconds). DB is source of truth; channel is a fast wake-up. 0 disables.
ATLAS_JOB_POLL_SECS=2

# Reclaim running jobs whose lock is older than this many seconds (0 disables).
ATLAS_JOB_STALE_SECS=900

# How often (seconds) the DataBridge reconciler advances edge/CDC/cutover drain (0 disables).
# ATLAS_DATABRIDGE_RECONCILE_SECS=15

# Kafka Connect image bundling Debezium + JDBC/Mongo sinks (required for real CDC).
# ATLAS_DATABRIDGE_CONNECT_IMAGE=

# JDBC sink primary-key fields (comma-separated); default "id".
# ATLAS_DATABRIDGE_SINK_PK_FIELDS=id

# Per-IP request rate limit (requests/minute) when auth is on; 0 disables.
# ATLAS_RATE_LIMIT_RPM=120

# Audit-log retention in days (0 = keep forever).
# ATLAS_AUDIT_RETENTION_DAYS=90

# Chargeback estimate USD per GiB-month (GET /chargeback).
# ATLAS_CHARGEBACK_USD_PER_GIB_MONTH=0.02

# Optional periodic self-state backup to S3/RGW (empty disables).
# ATLAS_STATE_BACKUP_ENDPOINT=
# ATLAS_STATE_BACKUP_BUCKET=
# ATLAS_STATE_BACKUP_ACCESS_KEY=
# ATLAS_STATE_BACKUP_SECRET_KEY=
# ATLAS_STATE_BACKUP_INTERVAL_SECS=3600

# Optional HTTPS listener (served alongside HTTP). Provide PEM cert+key paths.
# e.g. openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365 -subj /CN=atlas
ATLAS_HTTPS_ADDR=
ATLAS_TLS_CERT=
ATLAS_TLS_KEY=

# RUST_LOG controls tracing verbosity.
RUST_LOG=info,atlas_gateway=debug

# Optional Atlas Ops Advisor model. Without these values POST /api/atlas/v1/ai/advisor uses the
# built-in deterministic, explainable advisor. Any OpenAI-compatible /chat/completions endpoint
# works (vLLM, llama.cpp, Ollama proxy, OpenAI, or an internal AI gateway). HTTP is accepted only
# for localhost; remote endpoints must use HTTPS. Operational context is sent only when mode is
# "auto" or "llm"; use {"mode":"local"} to guarantee fully local analysis.
# ATLAS_AI_BASE_URL=https://ai-gateway.example.com/v1
# ATLAS_AI_API_KEY=
# ATLAS_AI_MODEL=qwen2.5-7b-instruct
# ATLAS_AI_TIMEOUT_SECS=15
