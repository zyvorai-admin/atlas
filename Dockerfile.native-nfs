# atlas-native-nfs: NFS gateway for atlas-native filesystems (docs/NATIVE_NFS.md). NFS-Ganesha
# (FSAL_VFS) serves FUSE mounts of each exported filesystem; atlas-native-nfs mounts them, writes
# the Ganesha configuration and supervises both. Ganesha runs as its own process (LGPL-3.0).
# ---- builder ----
FROM docker.io/library/rust:1.98-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS builder
WORKDIR /build
COPY . .
RUN cargo build --release --locked -p atlas-native-fuse --features fuse \
    --bin atlas-native-mount --bin atlas-native-nfs

# ---- runtime ----
# Ganesha 9.14 or later: older releases answer the GET_DIR_DELEGATION that recent Linux clients
# send with NFS4ERR_OP_ILLEGAL instead of NFS4ERR_NOTSUPP, which the client turns into EREMOTEIO
# on directory reads. Debian testing has it; Ubuntu 26.04 ships 6.5.
FROM docker.io/library/debian:testing@sha256:deae2af882a1b5f60a3646cd5d5f10ef1e65bc3b9d741b38f5c8ec4b0925a132 AS runtime
ARG DEBIAN_FRONTEND=noninteractive
# Ganesha finds the filesystem under each export through /etc/mtab. NFSv3 needs rpcbind (which
# looks its port up in /etc/services, from netbase) and rpc.statd (nfs-common) for NLM locks.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates fuse3 netbase \
        nfs-ganesha nfs-ganesha-vfs rpcbind nfs-common \
    && rm -rf /var/lib/apt/lists/* \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' nfs-ganesha)" ge 9.14 \
    && ln -sf /proc/self/mounts /etc/mtab
COPY --from=builder /build/target/release/atlas-native-mount /usr/local/bin/atlas-native-mount
COPY --from=builder /build/target/release/atlas-native-nfs /usr/local/bin/atlas-native-nfs
ENTRYPOINT ["/usr/local/bin/atlas-native-nfs"]
