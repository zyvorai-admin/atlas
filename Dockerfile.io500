# atlas-io500: IO500 benchmark runner for atlas-native filesystems (docs/IO500.md). Mounts a
# filesystem with atlas-native-mount and runs the IO500 suite (IOR, mdtest, pfind) on it under
# Open MPI. The benchmarks are unmodified upstream sources built as separate programs (IO500: MIT,
# IOR/mdtest: GPL-2.0, pfind: LGPL-3.0); nothing in Atlas links them.
# ---- builder ----
FROM docker.io/library/rust:1.99-bookworm@sha256:59037199c44290f2befcdd58dcc540164763fc296950255aaefeef096a1866b0 AS builder
ARG DEBIAN_FRONTEND=noninteractive
# IO500 SC26 release (tag io500-sc26_v1); prepare.sh pins IOR and pfind to its own commits.
ARG IO500_COMMIT=34a596582715934d2f7695302a7c51e8f7e73d9a
RUN apt-get update && apt-get install -y --no-install-recommends libopenmpi-dev openmpi-bin \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/IO500/io500.git /opt/io500 \
    && cd /opt/io500 && git checkout "$IO500_COMMIT" \
    && mkdir -p build/cdcl-schema-tools schema-tools \
    && ./prepare.sh \
    && cp --remove-destination build/pfind/pfind bin/pfind
WORKDIR /build
COPY . .
RUN cargo build --release --locked -p atlas-native-fuse --features fuse --bin atlas-native-mount

# ---- runtime ----
FROM docker.io/library/debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates fuse3 \
        openmpi-bin libopenmpi3 util-linux \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/io500/io500 /opt/io500/io500
COPY --from=builder /opt/io500/bin/ /opt/io500/bin/
COPY --from=builder /opt/io500/LICENSE /usr/share/doc/io500/LICENSE
COPY --from=builder /build/target/release/atlas-native-mount /usr/local/bin/atlas-native-mount
COPY deploy/io500/io500-run.sh /usr/local/bin/io500-run
ENV PATH="/opt/io500/bin:${PATH}"
ENTRYPOINT ["/usr/local/bin/io500-run"]
